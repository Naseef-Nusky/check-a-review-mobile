{
  "expo": {
    "name": "Check A Review",
    "slug": "check-a-review-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "checkareview",
    "splash": {
      "image": "./assets/logo-check-a-review.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.checkareview.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Check A Review to access your photos so you can upload a business logo.",
        "NSPhotoLibraryAddUsageDescription": "Allow Check A Review to save images when needed for your business profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.checkareview.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Check A Review to access your photos so you can upload a business logo."
        }
      ],
      "expo-asset"
    ]
  }
}
