{
  "expo": {
    "name": "Check A Review",
    "slug": "check-a-review-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "checkareview",
    "splash": {
      "image": "./assets/logo-check-a-review.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.checkareview.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Check A Review uses your photo library so you can set a profile picture and upload a business logo.",
        "NSPhotoLibraryAddUsageDescription": "Check A Review may save a cropped image when you set a profile picture or business logo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.checkareview.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "apiUrl": "https://api.checkareview.com/api",
      "router": {},
      "eas": {
        "projectId": "250de55e-01e4-4c90-bddc-3dc2b8fe1583"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Check A Review uses your photo library so you can set a profile picture and upload a business logo."
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "owner": "naseef-nusky"
  }
}
